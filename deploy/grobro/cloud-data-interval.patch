+
+    def __cloud_data_due(self, device_id: str, payload: bytes) -> bool:
+        """Whether this message should go to Growatt Cloud now (see GROWATT_CLOUD_DATA_INTERVAL)."""
+        # The Modbus function is the low byte of the message type, in the unscrambled header.
+        if GROWATT_CLOUD_DATA_INTERVAL <= 0 or len(payload) < 8:
+            return True
+        if payload[7] not in CLOUD_THROTTLED_FUNCTIONS:
+            return True
+        now = time.monotonic()
+        sent_at = self._cloud_data_sent_at.get(device_id)
+        if sent_at is not None and now - sent_at < GROWATT_CLOUD_DATA_INTERVAL:
+            return False
+        self._cloud_data_sent_at[device_id] = now
+        return True
 
