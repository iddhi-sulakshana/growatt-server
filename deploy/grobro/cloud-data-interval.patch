     def __on_connect(self, client, userdata, flags, reason_code, properties):
       LOG.debug(f"Connected to GroBro MQTT server with result code {reason_code}")
       self._client.subscribe("c/#")      
+
+    @staticmethod
+    def __is_throttled_reading(payload: bytes) -> bool:
+        # The Modbus function is the low byte of the message type, in the unscrambled header.
+        return (
+            GROWATT_CLOUD_DATA_INTERVAL > 0
+            and len(payload) >= 8
+            and payload[7] in CLOUD_THROTTLED_FUNCTIONS
+        )
+
+    def __cloud_data_due(self, device_id: str, payload: bytes) -> bool:
+        """Whether this message should go to Growatt Cloud now (see GROWATT_CLOUD_DATA_INTERVAL)."""
+        if not self.__is_throttled_reading(payload):
+            return True
+        sent_at = self._cloud_data_sent_at.get(device_id)
+        return sent_at is None or time.monotonic() - sent_at >= GROWATT_CLOUD_DATA_INTERVAL
 
